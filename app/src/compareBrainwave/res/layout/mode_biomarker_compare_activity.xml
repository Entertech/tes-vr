<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mode.biomarker.BiomarkerCompareModeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvProcessHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="流程：前测脑波3min -> 电流刺激30min -> 后测脑波3min -> 数据对比"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReceiveMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="接收到的消息：" />

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="设备状态：" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="流程执行状态"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBaselineStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="前测脑波采集（3min）：待执行" />

        <TextView
            android:id="@+id/tvStimulationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="电流刺激（30min）：待执行" />

        <TextView
            android:id="@+id/tvPostStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="后测脑波采集（3min）：待执行" />

        <TextView
            android:id="@+id/tvCompareStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="前后测数据对比：待执行" />

        <Button
            android:id="@+id/btnCollectBaselineEeg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="前测脑波采集（3min）" />

        <Button
            android:id="@+id/btnStartStimulation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="开始电流刺激（30min）" />

        <Button
            android:id="@+id/btnCollectPostEeg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="后测脑波采集（3min）" />

        <Button
            android:id="@+id/btnCompareData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="执行前后测数据对比" />

        <Button
            android:id="@+id/btnOpenPrecheckBoard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#F3E5C9"
            android:text="查看采集前预检面板（UI示例）"
            android:textColor="#7A531E" />

        <Button
            android:id="@+id/btnOpenInsightReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#DCEFE7"
            android:text="查看脑波洞察报告（UI示例）"
            android:textColor="#165C4A" />

        <Button
            android:id="@+id/btnOpenTrendOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#DDE8F4"
            android:text="查看疗程趋势总览（UI示例）"
            android:textColor="#224E7C" />

        <Button
            android:id="@+id/btnRunFullProcess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="一键触发流程接口（占位）" />

        <Button
            android:id="@+id/btnResetProcessState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:text="重置状态" />
    </LinearLayout>
</ScrollView>
